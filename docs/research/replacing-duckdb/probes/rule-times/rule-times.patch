+pub mod profile {
+    use std::collections::BTreeMap;
+    use std::sync::{LazyLock, Mutex};
+
+    pub(crate) static ON: LazyLock<bool> =
+        LazyLock::new(|| std::env::var_os("BURRMILL_RULE_PROFILE").is_some());
+
+    #[derive(Default)]
+    struct Stat {
+        calls: u64,
+        ns: u128,
+        changed: u64,
+        changed_ns: u128,
+        nodes: u64,
+    }
+
+    static STATS: LazyLock<Mutex<BTreeMap<(&'static str, String), Stat>>> =
+        LazyLock::new(Default::default);
+
+    pub(crate) fn nodes(p: &datafusion_expr::LogicalPlan) -> u64 {
+        use datafusion_common::tree_node::{TreeNode, TreeNodeRecursion};
+        let mut n = 0;
+        let _ = p.apply(|_| {
+            n += 1;
+            Ok(TreeNodeRecursion::Continue)
+        });
+        n
+    }
+
+    pub(crate) fn record(stage: &'static str, rule: &str, ns: u128, changed: bool, nodes: u64) {
+        let mut m = STATS.lock().unwrap();
+        let s = m.entry((stage, rule.to_string())).or_default();
+        s.calls += 1;
+        s.ns += ns;
+        s.nodes += nodes;
+        if changed {
+            s.changed += 1;
+            s.changed_ns += ns;
+        }
+    }
+
+    pub fn reset() {
+        STATS.lock().unwrap().clear();
+    }
+
+    pub fn report() -> String {
+        let m = STATS.lock().unwrap();
+        let total: u128 = m.values().map(|s| s.ns).sum();
+        let mut rows: Vec<_> = m.iter().collect();
+        rows.sort_by(|a, b| b.1.ns.cmp(&a.1.ns));
+        let mut out = format!("RULES\ttotal_ms={}\n", total / 1_000_000);
+        for ((stage, rule), s) in rows {
+            out += &format!(
+                "RULE\t{stage}\t{rule}\tms={:.1}\tshare={:.1}%\tcalls={}\tchanged={}\tchanged_ms={:.1}\tus_per_call={:.1}\tnodes_per_call={:.1}\n",
+                s.ns as f64 / 1e6,
+                100.0 * s.ns as f64 / total.max(1) as f64,
+                s.calls,
+                s.changed,
+                s.changed_ns as f64 / 1e6,
+                s.ns as f64 / 1e3 / s.calls.max(1) as f64,
+                s.nodes as f64 / s.calls.max(1) as f64,
+            );
+        }
+        out
+    }
+}
