diff --git a/crates/burrmill/src/df/plantimes.rs b/crates/burrmill/src/df/plantimes.rs
new file mode 100644
index 0000000..64e5ed6
--- /dev/null
+++ b/crates/burrmill/src/df/plantimes.rs
@@ -0,0 +1,194 @@
+//! Probe: where planning time goes, per rule. Off unless `BURRMILL_PLAN_TIMES` names a file
+//! prefix; then `<prefix>.<pid>` is rewritten after each statement with the totals and the
+//! dearest statement's own split.
+
+use std::collections::BTreeMap;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+use datafusion_common::Result;
+use datafusion_common::config::ConfigOptions;
+use datafusion_physical_plan::ExecutionPlan;
+use datafusion_session::PhysicalOptimizerRule;
+
+type Split = BTreeMap<(u8, String), (Duration, u64)>;
+
+#[derive(Default)]
+struct State {
+    total: Split,
+    current: Split,
+    worst: Split,
+    worst_sql: String,
+    sql: String,
+    statements: u64,
+}
+
+fn prefix() -> Option<&'static str> {
+    static P: OnceLock<Option<String>> = OnceLock::new();
+    P.get_or_init(|| std::env::var("BURRMILL_PLAN_TIMES").ok())
+        .as_deref()
+}
+
+pub fn on() -> bool {
+    prefix().is_some()
+}
+
+fn state() -> std::sync::MutexGuard<'static, State> {
+    static S: OnceLock<Mutex<State>> = OnceLock::new();
+    S.get_or_init(Default::default)
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+}
+
+pub fn add(stage: u8, name: &str, d: Duration) {
+    if !on() {
+        return;
+    }
+    let mut s = state();
+    let e = s.current.entry((stage, name.to_string())).or_default();
+    e.0 += d;
+    e.1 += 1;
+}
+
+/// The largest `n` seen under `name` in a statement, in the count column.
+pub fn count(name: &str, n: u64) {
+    if !on() {
+        return;
+    }
+    let mut s = state();
+    let e = s.current.entry((9, name.to_string())).or_default();
+    e.1 = e.1.max(n);
+}
+
+pub struct Span(u8, &'static str, Option<Instant>);
+
+pub fn span(stage: u8, name: &'static str) -> Span {
+    Span(stage, name, on().then(Instant::now))
+}
+
+impl Drop for Span {
+    fn drop(&mut self) {
+        if let Some(t) = self.2 {
+            add(self.0, self.1, t.elapsed());
+        }
+    }
+}
+
+pub fn begin(sql: &str) {
+    if !on() {
+        return;
+    }
+    state().sql = sql.to_string();
+}
+
+fn sum(s: &Split) -> Duration {
+    // Stage 9 holds spans inside rules, already counted by their rule.
+    s.iter().filter(|(k, _)| k.0 != 9).map(|(_, v)| v.0).sum()
+}
+
+fn write(out: &mut String, s: &Split) {
+    use std::fmt::Write;
+    let stage = |n: u8| match n {
+        0 => "parse",
+        1 => "analyzer",
+        2 => "optimizer",
+        3 => "physical",
+        _ => "inside",
+    };
+    let mut rows: Vec<_> = s.iter().collect();
+    rows.sort_by(|a, b| (a.0.0, b.1.0).cmp(&(b.0.0, a.1.0)));
+    for n in 0..4u8 {
+        let t: Duration = s.iter().filter(|(k, _)| k.0 == n).map(|(_, v)| v.0).sum();
+        let _ = writeln!(
+            out,
+            "STAGE {:<10} {:>12.3} ms",
+            stage(n),
+            t.as_secs_f64() * 1e3
+        );
+    }
+    for ((st, name), (d, n)) in rows {
+        let _ = writeln!(
+            out,
+            "{:<10} {:<44} {:>12.3} ms {:>9}",
+            stage(*st),
+            name,
+            d.as_secs_f64() * 1e3,
+            n
+        );
+    }
+}
+
+pub fn end() {
+    let Some(prefix) = prefix() else { return };
+    let mut s = state();
+    let current = std::mem::take(&mut s.current);
+    for (k, v) in &current {
+        let e = s.total.entry(k.clone()).or_default();
+        e.0 += v.0;
+        e.1 = if k.0 == 9 && v.0.is_zero() {
+            e.1.max(v.1)
+        } else {
+            e.1 + v.1
+        };
+    }
+    s.statements += 1;
+    if sum(&current) > sum(&s.worst) {
+        s.worst = current;
+        s.worst_sql = std::mem::take(&mut s.sql);
+    }
+    let mut out = format!(
+        "statements {}\ntotal {:.3} ms\n",
+        s.statements,
+        sum(&s.total).as_secs_f64() * 1e3
+    );
+    write(&mut out, &s.total);
+    out.push_str(&format!(
+        "\nDEAREST {:.3} ms: {}\n",
+        sum(&s.worst).as_secs_f64() * 1e3,
+        s.worst_sql.replace('\n', " ")
+    ));
+    write(&mut out, &s.worst);
+    let _ = std::fs::write(format!("{prefix}.{}", std::process::id()), out);
+}
+
+static IN_RULES: AtomicU64 = AtomicU64::new(0);
+
+/// Nanoseconds spent inside physical rules so far.
+pub fn in_rules() -> u64 {
+    IN_RULES.load(Ordering::Relaxed)
+}
+
+#[derive(Debug)]
+pub struct Timed(pub Arc<dyn PhysicalOptimizerRule + Send + Sync>);
+
+impl PhysicalOptimizerRule for Timed {
+    fn optimize(
+        &self,
+        plan: Arc<dyn ExecutionPlan>,
+        config: &ConfigOptions,
+    ) -> Result<Arc<dyn ExecutionPlan>> {
+        let t = Instant::now();
+        let r = self.0.optimize(plan, config);
+        IN_RULES.fetch_add(t.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        add(3, self.0.name(), t.elapsed());
+        r
+    }
+    fn optimize_with_context(
+        &self,
+        plan: Arc<dyn ExecutionPlan>,
+        context: &dyn datafusion_session::PhysicalOptimizerContext,
+    ) -> Result<Arc<dyn ExecutionPlan>> {
+        let t = Instant::now();
+        let r = self.0.optimize_with_context(plan, context);
+        IN_RULES.fetch_add(t.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        add(3, self.0.name(), t.elapsed());
+        r
+    }
+    fn name(&self) -> &str {
+        self.0.name()
+    }
+    fn schema_check(&self) -> bool {
+        self.0.schema_check()
+    }
+}
