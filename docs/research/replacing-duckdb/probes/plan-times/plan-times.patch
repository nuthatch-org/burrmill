+/// Probe: the relations the walk counts in each statement of `sql`.
+pub fn relations_in(sql: &str) -> Vec<usize> {
+    fn inner(stmt: &DfStatement) -> usize {
+        match stmt {
+            DfStatement::Statement(s) => {
+                let mut w = Walk {
+                    work: vec![Work::Stmt(s, 0, 0)],
+                    groups: Vec::new(),
+                    relations: 0,
+                };
+                while let Some(work) = w.work.pop() {
+                    match work {
+                        Work::Stmt(stmt, d, n) => {
+                            let _ = w.statement(stmt, d, n);
+                        }
+                        Work::Query(q, d, n) => w.query(q, d, n),
+                        Work::Set(set, sd, d, n) => {
+                            let _ = w.set(set, sd, d, n);
+                        }
+                        Work::Expr(e, d, g, n) => w.expand(e, d, g, n),
+                    }
+                }
+                w.relations
+            }
+            DfStatement::Explain(e) => inner(e.statement.as_ref()),
+            _ => 0,
+        }
+    }
+    match super::dialect::parse_statements(sql) {
+        Ok(stmts) => stmts.iter().map(inner).collect(),
+        Err(_) => Vec::new(),
+    }
+}
