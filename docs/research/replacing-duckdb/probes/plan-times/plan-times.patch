+/// `relations <views-dir | sql-file>...`: the relations the depth walk counts in each view body
+/// or statement, the largest first.
+pub fn relations(paths: &[String]) -> anyhow::Result<()> {
+    let mut all: Vec<(usize, String)> = Vec::new();
+    for p in paths {
+        let path = Path::new(p);
+        if path.is_dir() {
+            for v in crate::df_views::load_views(path)? {
+                let n = burrmill::df::relations_in(&v.body);
+                if n.is_empty() {
+                    println!("UNPARSED {p} {}", v.name);
+                }
+                all.extend(n.into_iter().map(|n| (n, format!("{p} {}", v.name))));
+            }
+            continue;
+        }
+        let text = std::fs::read_to_string(path)?;
+        for (i, stmt) in text.split(";\n").enumerate() {
+            if stmt.trim().is_empty() {
+                continue;
+            }
+            let n = burrmill::df::relations_in(stmt);
+            if n.is_empty() {
+                println!("UNPARSED {p} #{i}");
+            }
+            all.extend(n.into_iter().map(|n| (n, format!("{p} #{i}"))));
+        }
+    }
+    all.sort_by(|a, b| b.cmp(a));
+    for (n, what) in all.iter().take(15) {
+        println!("RELATIONS {n:>5} {what}");
+    }
+    println!("RELATIONS-MAX {} over {} statements", all.first().map_or(0, |a| a.0), all.len());
+    Ok(())
+}
+
+/// `join-chain <n>...`: seconds to answer a statement over `n` one-row relations, as a star of
+/// `JOIN ... ON`, as a chain of them and as a comma list; the least of three runs each.
+pub fn join_chain(sizes: &[String]) -> anyhow::Result<()> {
+    for n in sizes.iter().filter_map(|n| n.parse::<usize>().ok()) {
+        let star: String = (1..n)
+            .map(|i| format!(" JOIN range(1) t{i} ON t0.range = t{i}.range"))
+            .collect();
+        let chain: String = (1..n)
+            .map(|i| format!(" JOIN range(1) t{i} ON t{}.range = t{i}.range", i - 1))
+            .collect();
+        let comma: String = (1..n).map(|i| format!(", range(1) t{i}")).collect();
+        for (shape, tail) in [("star", star), ("chain", chain), ("comma", comma)] {
+            let sql = format!("SELECT count(*) AS n FROM range(1) t0{tail}");
+            let mut least = f64::MAX;
+            let mut answer = String::new();
+            for _ in 0..3 {
+                let q = sql.clone();
+                let t = Instant::now();
+                let r = std::thread::spawn(move || {
+                    let e = burrmill::Engine::open_empty()?;
+                    let r = e.sql(&q).map(|b| b.iter().map(|b| b.num_rows()).sum::<usize>());
+                    std::thread::spawn(move || drop(e)).join().expect("drop");
+                    r
+                })
+                .join()
+                .expect("engine thread");
+                least = least.min(t.elapsed().as_secs_f64());
+                answer = match r {
+                    Ok(rows) => format!("{rows} row"),
+                    Err(e) => first_line(&e.to_string()),
+                };
+            }
+            println!("JOIN-CHAIN {n:>4} {shape:<5} least {least:>8.3} s  {answer}");
+        }
+    }
+    Ok(())
+}
+
+/// `plan-times <nest> [runs]`: each view planned, not run, `runs` times (default 9); the median
+/// and the least in milliseconds. `BUDGET_MB` plans as a host's session does.
+pub fn plan_times(root: &str, runs: usize) -> anyhow::Result<()> {
+    let root = Path::new(root).to_path_buf();
+    let nest = load_nest(&root)?;
+    let runs = runs.max(1);
+    std::thread::spawn(move || -> anyhow::Result<()> {
+        let mut e = open_engine(&root)?;
+        for v in &nest.views {
+            if let Err(why) = e.register_view(&v.name, &v.body) {
+                println!(
+                    "REGISTER-FAIL {:<34} {}",
+                    v.name,
+                    first_line(&why.to_string())
+                );
+            }
+        }
+        let mut total = 0.0;
+        for v in &nest.views {
+            let sql = format!("SELECT * FROM \"{}\"", v.name);
+            // The count refuses some operators, after the plan it is asked about is built.
+            let mut refused = String::new();
+            let mut ms = Vec::new();
+            for _ in 0..runs {
+                let t = Instant::now();
+                if let Err(e) = e.parquet_scans(&sql) {
+                    refused = first_line(&e.to_string());
+                }
+                ms.push(t.elapsed().as_secs_f64() * 1e3);
+            }
+            ms.sort_by(f64::total_cmp);
+            total += ms[ms.len() / 2];
+            println!(
+                "PLAN {:<34} median {:>9.3} ms  least {:>9.3} ms  {refused}",
+                v.name,
+                ms[ms.len() / 2],
+                ms[0]
+            );
+        }
+        println!(
+            "PLAN-TOTAL median sum {total:.3} ms over {} views",
+            nest.views.len()
+        );
+        std::thread::spawn(move || drop(e)).join().expect("drop");
+        Ok(())
+    })
+    .join()
+    .expect("plan thread")
+}
